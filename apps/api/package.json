{
  "name": "@grey-flowers/api",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.mjs"
    }
  },
  "scripts": {
    "auth:promote-admin": "node --env-file-if-exists=../../.env --import tsx src/cli/promote-admin.ts",
    "auth:register-user": "node --env-file-if-exists=../../.env --import tsx src/cli/register-user.ts",
    "build": "tsdown",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:api",
    "@grey-flowers/contracts": "workspace:*",
    "@grey-flowers/db": "workspace:*",
    "@hono/node-server": "catalog:api",
    "@hono/zod-validator": "catalog:api",
    "@nuxtjs/mdc": "catalog:api",
    "bcryptjs": "catalog:api",
    "es-toolkit": "catalog:api",
    "file-type": "catalog:api",
    "hono": "catalog:api",
    "jose": "catalog:api",
    "music-metadata": "catalog:api",
    "pino": "catalog:api",
    "pinyin-pro": "catalog:api",
    "rehype-sanitize": "catalog:api",
    "sharp": "catalog:api",
    "zod": "catalog:api"
  },
  "devDependencies": {
    "pino-pretty": "catalog:api",
    "tsdown": "catalog:api",
    "tsx": "catalog:api"
  }
}
