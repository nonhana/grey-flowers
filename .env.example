NODE_ENV="development"

HANA_DATABASE_URL="postgresql://your_user_name:your_password@localhost:5432/grey_flowers?schema=public"

API_BASE_URL="xxx"

API_PORT="2408"
ADMIN_PORT="2409"
MAIN_PORT="2410"

AUTH_ACCESS_TOKEN_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AUTH_REFRESH_TOKEN_PEPPER="yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# 可选：本服务前置的可信反代层数（限流取客户端 IP 用）。
# 不填时 production 按 1（nginx）、development 按 0（直连）推导。
# CDN + nginx 这类两层链路要显式写 2。
# API_TRUSTED_PROXY_HOPS="1"

R2_ACCOUNT_ID="<cloudflare_account_id>"
R2_ACCESS_KEY_ID="<r2_api_token_access_key>"
R2_SECRET_ACCESS_KEY="<r2_api_token_secret>"
R2_BUCKET_NAME="blog"
R2_PUBLIC_URL="https://blog-r2.caelum.moe"

HANA_MAIL_ENABLE="false"
RESEND_API_KEY="xxxx"
RESEND_FROM="xxxx"
