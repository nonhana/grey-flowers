{
"name": "@grey-flowers/db",
 "private": true,
 "type": "module",
 "files": [
  "dist"
 ],
 "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:dev": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:reset": "node --env-file-if-exists=../../.env --import tsx scripts/guard-local-db.mts && node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate reset --force && node --env-file-if-exists=../../.env --import tsx prisma/seed.mts",
    "prisma:push": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js db push",
    "prisma:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.mts",
    "prisma:studio": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js studio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:db",
    "@prisma/client": "catalog:db",
    "pg": "catalog:db"
  },
  "devDependencies": {
    "@types/pg": "catalog:db",
    "bcryptjs": "catalog:",
    "prisma": "catalog:db",
    "tsdown": "catalog:",
    "tsx": "catalog:"
  }
}
