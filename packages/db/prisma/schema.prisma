generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Article {
  id           Int                  @id @default(autoincrement())
  to           String               @unique
  title        String
  description  String?
  cover        String
  coverAssetId Int?
  alt          String
  publishedAt  DateTime             @default(now())
  editedAt     DateTime
  published    Boolean              @default(false)
  wordCount    Int                  @default(0)
  revision     Int                  @default(0)
  categoryId   Int?
  content      String?              @default("")
  category     Category?            @relation(fields: [categoryId], references: [id])
  coverAsset   Asset?               @relation("ArticleCoverAsset", fields: [coverAssetId], references: [id], onDelete: Restrict)
  inlineAssets ArticleInlineAsset[]
  tags         Tag[]                @relation("ArticleTags")
  snapshots    ArticleSnapshot[]

  @@index([title(ops: raw("gin_trgm_ops"))], map: "Article_search_title_trgm_idx", type: Gin, where: raw("(published = true)"))
  @@index([coverAssetId])
}

model Tag {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  articleCount Int       @default(0)
  articles     Article[] @relation("ArticleTags")
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  cover        String
  coverAssetId Int?
  articleCount Int       @default(0)
  articles     Article[]
  coverAsset   Asset?    @relation("CategoryCoverAsset", fields: [coverAssetId], references: [id], onDelete: Restrict)

  @@index([coverAssetId])
}

model ArticleSnapshot {
  id          Int      @id @default(autoincrement())
  articleId   Int
  revision    Int
  title       String
  description String?
  content     String
  wordCount   Int
  createdById Int
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([articleId, revision])
  @@index([articleId])
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  site             String?
  avatar           String
  password         String
  username         String            @unique
  createdAt        DateTime          @default(now())
  role             UserRole          @default(USER)
  updatedAt        DateTime          @updatedAt
  comments         Comment[]
  replies          Comment[]         @relation("ReplyToUser")
  userMessage      UserMessage[]
  createdAssets    Asset[]           @relation("AssetCreatedBy")
  sessions         Session[]
  articleSnapshots ArticleSnapshot[]
}

model Session {
  id                        String               @id @default(cuid())
  userId                    Int
  refreshSecretHash         String
  previousRefreshSecretHash String? // 上一次轮换前的 hash：refresh 轮换 + 重用检测
  createdAt                 DateTime             @default(now())
  lastUsedAt                DateTime             @default(now())
  expiresAt                 DateTime
  revokedAt                 DateTime?
  revokeReason              SessionRevokeReason?
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Comment {
  id               Int           @id @default(autoincrement())
  content          String
  level            CommentLevel  @default(PARENT)
  parentId         Int?
  authorId         Int
  replyToUserId    Int?
  publishedAt      DateTime      @default(now())
  editedAt         DateTime      @updatedAt
  replyToCommentId Int?
  path             String
  contentMarkdown  Json?
  author           User          @relation(fields: [authorId], references: [id])
  parent           Comment?      @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children         Comment[]     @relation("ParentChild")
  replyToComment   Comment?      @relation("ReplyToComment", fields: [replyToCommentId], references: [id], onDelete: SetNull)
  replies          Comment[]     @relation("ReplyToComment")
  replyToUser      User?         @relation("ReplyToUser", fields: [replyToUserId], references: [id])
  userMessage      UserMessage[]
}

model UserMessage {
  id         Int     @id @default(autoincrement())
  receiverId Int
  commentId  Int
  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  receiver   User    @relation(fields: [receiverId], references: [id])

  @@unique([receiverId, commentId])
}

model Activity {
  id              Int                  @id @default(autoincrement())
  content         String               @default("")
  images          String[]             @default([])
  publishedAt     DateTime             @default(now())
  editedAt        DateTime             @updatedAt
  contentMarkdown Json?
  imageAssets     ActivityImageAsset[]
  music           ActivityMusic[]
}

model Music {
  id            Int             @id @default(autoincrement())
  title         String
  src           String
  sourceAssetId Int?
  seconds       Int
  album         String
  artist        String
  cover         String
  coverAssetId  Int?
  createdAt     DateTime        @default(now()) // 入库时间，供库排序与展示
  activities    ActivityMusic[]
  sourceAsset   Asset?          @relation("MusicSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  coverAsset    Asset?          @relation("MusicCoverAsset", fields: [coverAssetId], references: [id], onDelete: Restrict)

  @@index([sourceAssetId])
  @@index([coverAssetId])
}

model ActivityMusic {
  activityId Int
  musicId    Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  music      Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@id([activityId, musicId])
  @@index([musicId])
}

model Asset {
  id                  Int                  @id @default(autoincrement())
  storageKey          String               @unique
  mediaType           AssetMediaType
  mimeType            String
  byteSize            BigInt
  width               Int?
  height              Int?
  durationMs          Int?
  status              AssetStatus          @default(AVAILABLE)
  createdById         Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  createdBy           User                 @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  articleCovers       Article[]            @relation("ArticleCoverAsset")
  categoryCovers      Category[]           @relation("CategoryCoverAsset")
  musicSources        Music[]              @relation("MusicSourceAsset")
  musicCovers         Music[]              @relation("MusicCoverAsset")
  activityImages      ActivityImageAsset[]
  articleInlineAssets ArticleInlineAsset[]

  @@index([status])
  @@index([createdById])
}

model ArticleInlineAsset {
  articleId Int
  assetId   Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([articleId, assetId])
  @@index([assetId])
}

model ActivityImageAsset {
  activityId Int
  assetId    Int
  position   Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([activityId, assetId])
  @@unique([activityId, position])
  @@index([assetId])
}

enum CommentLevel {
  PARENT
  CHILD
}

enum UserRole {
  USER
  ADMIN
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  REUSE_DETECTED
  ROLE_CHANGED
}

enum AssetMediaType {
  IMAGE
  AUDIO
}

enum AssetStatus {
  AVAILABLE
  PENDING_CLEANUP
  DELETED
}
